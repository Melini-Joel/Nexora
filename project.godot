; Archivo de configuración del proyecto de Godot 4.

config_version=5

[application]

config/name="NEXORA"
config/description="RPG cooperativo de mundo abierto (2 a 6 jugadores)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.039, 0.075, 0.114, 1)
boot_splash/image="res://logo/nexora_logo.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Game="*res://scripts/autoload/game.gd"
Network="*res://scripts/autoload/network.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
Cinematics="*res://scripts/autoload/cinematics.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=1
