; Archivo de configuración del proyecto de Godot 4.

config_version=5

[application]

config/name="NEXORA"
config/description="RPG cooperativo de mundo abierto (2 a 6 jugadores)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Game="*res://scripts/autoload/game.gd"
Network="*res://scripts/autoload/network.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
Cinematics="*res://scripts/autoload/cinematics.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=1
